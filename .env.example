# Plex Server Configuration
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here

# Plex Libraries to Index (comma-separated)
# Examples:
#   Movies,TV Shows (default)
#   Movies,TV Shows,4K Movies
#   John's Movies,John's TV Shows
# Leave empty to index all libraries
PLEX_SECTIONS=Movies,TV Shows

# Service Configuration
SERVICE_PORT=8000
